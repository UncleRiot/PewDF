root = true

[*.cs]
# IDE0130 is disabled because existing partial classes share namespaces across
# feature subfolders. Changing namespace policy requires coordinated source changes.
dotnet_diagnostic.IDE0130.severity = none

# Viewer migration bridge members intentionally retain their underscore-prefixed aliases so
# shared partial-class code can address per-tab state without duplicating the implementation.
# Keep normal naming analysis enabled everywhere else.
[MainWindow.xaml.cs]
dotnet_diagnostic.IDE1006.severity = none

[Controls/Viewer/PdfViewer.Bridge*.cs]
dotnet_diagnostic.IDE1006.severity = none

[Features/Viewer/MainWindow{ViewerBridge,TabStubs}.cs]
dotnet_diagnostic.IDE1006.severity = none

[Shell/{AnnotationBars,FileOperations,ContextMenu,Ocr,PageOperations,Shapes}.cs]
dotnet_diagnostic.IDE1006.severity = none
